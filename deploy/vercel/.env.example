TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=
FOLLOWVILLE_ADMIN_EMAIL=
FOLLOWVILLE_ADMIN_PASSWORD=
# Optional owner recovery: set 1 for the first reset, increase for later resets.
# Applies FOLLOWVILLE_ADMIN_PASSWORD once and revokes only the owner's sessions.
# FOLLOWVILLE_ADMIN_PASSWORD_RESET_VERSION=1
# Production URL. Leave unset on Preview to infer the origin from the request.
# BETTER_AUTH_URL=https://your-project.vercel.app
